rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /reminders/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /circles/{code} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && code.size() == 6
        && request.resource.data.keys().hasOnly(['name', 'goal', 'total', 'owner', 'createdAt', 'endsAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.goal is int && request.resource.data.goal > 0 && request.resource.data.goal <= 10000000
        && request.resource.data.total == 0
        && request.resource.data.owner == request.auth.uid;

      // Members can only increase the total, by at most 2000 per write
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/circles/$(code)/members/$(request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total'])
        && request.resource.data.total > resource.data.total
        && request.resource.data.total - resource.data.total <= 2000;

      match /members/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'joinedAt', 'lastActive'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 30;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // صدقة جارية: two shared totals; anyone signed in can add 1 dua or up to 2000 dhikr per write
    match /stats/sadaqa {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['duas', 'dhikr'])
        && (request.resource.data.get('duas', 0) - (resource == null ? 0 : resource.data.get('duas', 0))) in [0, 1]
        && (request.resource.data.get('dhikr', 0) - (resource == null ? 0 : resource.data.get('dhikr', 0))) >= 0
        && (request.resource.data.get('dhikr', 0) - (resource == null ? 0 : resource.data.get('dhikr', 0))) <= 2000;
    }

    // one counter per name (n0, n1, …): each write adds exactly 1 to exactly one name
    match /stats/shuhada {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['n0', 'n1', 'n2', 'n3', 'n4', 'n5', 'n6', 'n7', 'n8', 'n9', 'n10', 'n11', 'n12', 'n13', 'n14', 'n15', 'n16', 'n17', 'n18', 'n19', 'n20', 'n21', 'n22', 'n23', 'n24', 'n25', 'n26', 'n27', 'n28', 'n29'])
        && request.resource.data.size() == 1
        && request.resource.data.values()[0] == 1;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n0', 'n1', 'n2', 'n3', 'n4', 'n5', 'n6', 'n7', 'n8', 'n9', 'n10', 'n11', 'n12', 'n13', 'n14', 'n15', 'n16', 'n17', 'n18', 'n19', 'n20', 'n21', 'n22', 'n23', 'n24', 'n25', 'n26', 'n27', 'n28', 'n29'])
        && request.resource.data[request.resource.data.diff(resource.data).affectedKeys().toList()[0]]
           == resource.data.get(request.resource.data.diff(resource.data).affectedKeys().toList()[0], 0) + 1;
    }
  }
}
